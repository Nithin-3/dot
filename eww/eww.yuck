(defpoll time :interval "1s"
  "date '+%H:%M:%S'")

(defpoll date :interval "60s"
  "date '+%a, %d %b %Y'")

(defwindow clock
 :monitor 0

  :geometry (geometry :x "70%" :y "70%" :width "320px" :height "140px")
  :stacking "bg"
  :focusable false

  (box
    :orientation "v"
    :spacing 10
    (label :text time :class "time")
    (label :text date :class "date")))

(defwindow windows
 :monitor 0
  :geometry (geometry :x "80%" :y "85%" :width "400px" )
  :stacking "fg"
  :focusable false

  (box
    :orientation "v"
    (label :text "Activate Linux" :class "title" :xalign 0)
    (label :text "force yout co-worker to use linux" :class "subtitle" :xalign 0)
))
